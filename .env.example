# Email — direct Postmark send path (see app/lib/mailer.server.ts).
# Unset in dev/tests; messages land in `.outbox/` instead.
POSTMARK_SERVER_TOKEN=

# Novu Cloud EU — notifications transport (see app/lib/notifier.server.ts
# and docs/adr/0006-adopt-novu-cloud-eu-for-notifications.md).
# Workspace is provisioned in the EU (Frankfurt) region; the API endpoint
# is eu.api.novu.co. Unset in dev/tests; triggers land in
# `.notifications-outbox/` instead.
NOVU_API_KEY=

# Novu application identifier — public, embedded in the browser Inbox widget
# at `/settings/notifications` (see app/routes/settings.notifications.tsx).
# Found under Settings → API keys in the Novu dashboard.
NOVU_APPLICATION_IDENTIFIER=
